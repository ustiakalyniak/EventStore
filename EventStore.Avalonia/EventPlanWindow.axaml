<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EventStore.Avalonia.ViewModels"
        x:Class="EventStore.Avalonia.EventPlanWindow"
        x:DataType="vm:EventPlanViewModel"
        Title="План та кошторис події — EventStore"
        Width="780" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#FCF6F6">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Верхня панель (Бюджет, прогрес та попередження про перевищення) -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BoxShadow="0 4 10 0 #05000000">
            <StackPanel>
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding CurrentEvent.Name}" FontSize="22" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                            <Border Background="#FCEAEB" CornerRadius="15" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentEvent.EventType}" FontSize="12" Foreground="#DC7684" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentEvent.Date, StringFormat='Дата проведення: {0:dd.MM.yyyy}'}" FontSize="13" Foreground="#999999" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Загальний бюджет" FontSize="12" Foreground="#999999" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentEvent.Budget, StringFormat='{}{0:N0} грн'}" FontSize="20" FontWeight="Bold" Foreground="#DC7684" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#F0F0F0" Margin="0,15"/>

                <!-- БЛОК ПОПЕРЕДЖЕННЯ ПРО ПЕРЕВИЩЕННЯ (Юз-кейс: Оптимізувати бюджет / Попередження) -->
                <Border Background="#FDF2F2" BorderBrush="#F5C6CB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12" IsVisible="{Binding IsBudgetExceeded}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BudgetWarningText}" FontSize="12" FontWeight="Bold" Foreground="#C9302C" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Готовність заходу:" FontSize="13" FontWeight="Bold" Foreground="#555555"/>
                            <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" Foreground="#DC7684"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TotalAllocatedBudget, StringFormat='Розподілено: {0:N0} грн'}" FontSize="13" Foreground="#999999"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="8" Foreground="#DC7684" Background="#F5F5F5" CornerRadius="4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Список завдань -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15,5" BoxShadow="0 4 10 0 #05000000">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding PlanItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="5,10">
                                <Grid ColumnDefinitions="140, *, Auto" VerticalAlignment="Center">
                                    <!-- 1. Кнопка статусу -->
                                    <Button Grid.Column="0"
                                            Command="{Binding ToggleStatusCommand}"
                                            Background="{Binding StatusBgColor}"
                                            CornerRadius="15"
                                            Width="130"
                                            Height="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Medium" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Центральна частина -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Spacing="3">
                                        <TextBlock Text="{Binding Model.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Model.Category}" FontSize="11" Foreground="#999999"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Button Content="{Binding VendorButtonText}" 
                                                    Command="{Binding OpenVendorSelectionCommand}"
                                                    Background="{Binding VendorButtonBg}" 
                                                    Foreground="{Binding VendorButtonFg}" 
                                                    FontWeight="SemiBold"
                                                    FontSize="11"
                                                    CornerRadius="5" 
                                                    Padding="8,3"
                                                    Cursor="Hand"
                                                    IsVisible="{Binding CanHaveVendor}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 3. Вартість праворуч -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Model.Cost, StringFormat='{}{0:N0} грн'}" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="#444444" 
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="15,0,5,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Нижня панель -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,15,0,0">
            <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="💡" FontSize="13" Foreground="#999999"/>
                    <TextBlock Text="Клікніть на статус завдання, щоб перемикнути стан" FontSize="11" Foreground="#999999"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding OpenFinanceCommand}"
                            Content="Фінанси та Бюджет 💰"
                            Background="#6E9E75" 
                            Foreground="White"
                            FontWeight="Bold"
                            CornerRadius="8"
                            Padding="15,8"
                            Cursor="Hand"/>
                    
                    <Button Command="{Binding OpenGuestListCommand}"
                            Content="Список гостей"
                            Background="#A48585" 
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="15,8"
                            Cursor="Hand"/>

                    <Button Content="Запрошення 💌"
                            Click="OnOpenInvitationClick"
                            Background="#DC7684" 
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="15,8"
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" 
                    Command="{Binding CloseCommand}"
                    Content="Закрити"
                    Background="#DC7684"
                    Foreground="White"
                    FontWeight="Bold"
                    CornerRadius="8"
                    Padding="20,8"
                    VerticalAlignment="Top"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>