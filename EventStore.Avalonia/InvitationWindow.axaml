<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EventStore.Avalonia.InvitationWindow"
        Title="Створення та редагування запрошення — EventStore"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#FCF6F6">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <!-- Верхня панель заголовка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="💌 Запрошення на подію" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Налаштуйте стиль та персоналізуйте текст запрошення для ваших гостей" FontSize="13" Foreground="#999999" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Центральна частина: вибір шаблону та редагування тексту -->
        <Grid Grid.Row="1" ColumnDefinitions="210, 15, *">
            
            <!-- Ліва колонка: Вибір шаблону -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" BoxShadow="0 4 10 0 #05000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="Стиль шаблону:" FontWeight="Bold" FontSize="14" Foreground="#444444"/>
                    
                    <RadioButton Name="ClassicRadio" Content="Класичний" IsChecked="True" Checked="OnTemplateChanged" Foreground="#333333"/>
                    <RadioButton Name="ModernRadio" Content="Сучасний" Checked="OnTemplateChanged" Foreground="#333333"/>
                    <RadioButton Name="MinimalismRadio" Content="Мінімалізм" Checked="OnTemplateChanged" Foreground="#333333"/>

                    <Border Height="1" Background="#F0F0F0" Margin="0,10"/>

                    <TextBlock Text="💡 Порада:" FontWeight="Bold" FontSize="12" Foreground="#888888"/>
                    <TextBlock Text="Шаблон автоматично адаптує стиль оформлення та текст відповідно до деталей вашої події." FontSize="11" Foreground="#999999" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Права колонка: Попередній перегляд та Редагування тексту -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="15" BoxShadow="0 4 10 0 #05000000">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="Текст запрошення (Редагується):" FontWeight="Bold" FontSize="14" Foreground="#444444" Margin="0,0,0,8"/>
                    
                    <TextBox Grid.Row="1" 
                             Name="InvitationTextEditor" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             FontSize="13" 
                             Background="#FAFAFA"
                             BorderBrush="#E0E0E0"
                             CornerRadius="8"
                             Padding="10"/>

                    <TextBlock Grid.Row="2" Name="StatusMsg" Text="" FontSize="11" Foreground="#2E7D32" Margin="0,8,0,0" IsVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижня панель кнопок -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,15,0,0">
            <Button Grid.Column="0" 
                    Content="Скасувати" 
                    Click="OnCancelClick"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    FontWeight="SemiBold"
                    CornerRadius="8"
                    Padding="20,8"
                    HorizontalAlignment="Left"
                    Cursor="Hand"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Зберегти зміни" 
                        Click="OnSaveClick"
                        Background="#6E9E75"
                        Foreground="White"
                        FontWeight="Bold"
                        CornerRadius="8"
                        Padding="20,8"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>