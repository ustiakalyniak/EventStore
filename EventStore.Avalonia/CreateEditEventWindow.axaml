<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EventStore.Avalonia.ViewModels"
        x:Class="EventStore.Avalonia.CreateEditEventWindow"
        x:DataType="vm:CreateEditEventViewModel"
        Title="EventStore"
        Width="600"
        Height="730"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FAF7F8">

    <Window.Styles>
        <Style Selector="Button.ChoiceCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EFE2E5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.ChoiceCard:pointerover">
            <Setter Property="Background" Value="#FDF6F7"/>
            <Setter Property="BorderBrush" Value="#E2ABB3"/>
        </Style>

        <!-- Вирівнювання тексту всередині DatePicker по центру (день, місяць, рік) -->
        <Style Selector="DatePicker /template/ TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="DatePicker /template/ Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Padding="24">
        <!-- Головна картка форми -->
        <Border Background="White"
                CornerRadius="16"
                BorderBrush="#F3E5E8"
                BorderThickness="1"
                Padding="32,28">
            <Grid RowDefinitions="Auto,*,Auto">
                
                <!-- Індикатор прогресу (3 смужки) -->
                <Grid Grid.Row="0" Margin="0,0,0,24" ColumnDefinitions="*,10,*,10,*">
                    <Border Grid.Column="0" Height="5" CornerRadius="3" Background="#D97A88"/>
                    <Border Grid.Column="2" Height="5" CornerRadius="3" Background="#F2E1E4"/>
                    <Border Grid.Column="4" Height="5" CornerRadius="3" Background="#F2E1E4"/>
                </Grid>

                <!-- Вміст кроків -->
                <ScrollViewer Grid.Row="1">
                    <Panel>
                        <!-- ================= КРОК 1 ================= -->
                        <StackPanel IsVisible="{Binding IsStep1}" Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Крок 1 з 3" FontSize="12" Foreground="#A88B92" FontWeight="Medium"/>
                                <TextBlock Text="Базова інформація" FontSize="22" FontWeight="Bold" Foreground="#3D292D"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Назва заходу (необов'язково)" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <TextBox Text="{Binding Name}" Watermark="Наприклад: Весілля Марії та Олега" CornerRadius="8" Height="38" BorderBrush="#EADCE0"/>
                            </StackPanel>

                            <!-- 6 типів подій (однаковий розмір карток 3x2) -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Тип події *" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="*,8,*,8,*">
                                    <Button Grid.Row="0" Grid.Column="0" Classes="ChoiceCard" Height="46"
                                            Command="{Binding ChooseWeddingCommand}">
                                        <TextBlock Text="Весілля" FontWeight="SemiBold" Foreground="#3D292D" FontSize="13"/>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="2" Classes="ChoiceCard" Height="46"
                                            Command="{Binding ChooseBirthdayCommand}">
                                        <TextBlock Text="День народж." FontWeight="SemiBold" Foreground="#3D292D" FontSize="12"/>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="4" Classes="ChoiceCard" Height="46"
                                            Command="{Binding ChooseCorporateCommand}">
                                        <TextBlock Text="Корпоратив" FontWeight="SemiBold" Foreground="#3D292D" FontSize="13"/>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="0" Classes="ChoiceCard" Height="46"
                                            Command="{Binding ChooseGraduationCommand}">
                                        <TextBlock Text="Випускний" FontWeight="SemiBold" Foreground="#3D292D" FontSize="13"/>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="2" Classes="ChoiceCard" Height="46"
                                            Command="{Binding ChooseChristeningCommand}">
                                        <TextBlock Text="Хрестини" FontWeight="SemiBold" Foreground="#3D292D" FontSize="13"/>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="4" Classes="ChoiceCard" Height="46"
                                            Command="{Binding ChoosePartyCommand}">
                                        <TextBlock Text="Вечірка" FontWeight="SemiBold" Foreground="#3D292D" FontSize="13"/>
                                    </Button>
                                </Grid>
                                
                                <Border Background="#FBF2F4" BorderBrush="#F0D5DA" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedEventType, StringFormat='Обраний тип: {0}'}"
                                               FontSize="13" Foreground="#D97A88" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Дата події" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <DatePicker SelectedDate="{Binding Date}"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="8"
                                            BorderBrush="#EADCE0"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Кількість гостей" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <NumericUpDown Value="{Binding GuestsCount}" Minimum="1" Maximum="5000" Increment="5" FormatString="0" CornerRadius="8" BorderBrush="#EADCE0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ================= КРОК 2 ================= -->
                        <StackPanel IsVisible="{Binding IsStep2}" Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Крок 2 з 3" FontSize="12" Foreground="#A88B92" FontWeight="Medium"/>
                                <TextBlock Text="Бюджет та стиль" FontSize="22" FontWeight="Bold" Foreground="#3D292D"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Максимальний бюджет, грн" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <NumericUpDown Value="{Binding Budget}" Minimum="500" Maximum="50000000" Increment="5000" FormatString="N0" CornerRadius="8" BorderBrush="#EADCE0"/>
                            </StackPanel>

                            <!-- Стилі оформлення -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Стиль події *" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <Grid RowDefinitions="Auto,10,Auto" ColumnDefinitions="*,10,*">
                                    <Button Grid.Row="0" Grid.Column="0" Classes="ChoiceCard" Height="76"
                                            Command="{Binding ChooseClassicCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="70" Height="14" CornerRadius="4" Background="#8A4A57"/>
                                            <TextBlock Text="Класичний" FontSize="13" FontWeight="SemiBold" Foreground="#3D292D"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="0" Grid.Column="2" Classes="ChoiceCard" Height="76"
                                            Command="{Binding ChooseRomanticCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="70" Height="14" CornerRadius="4" Background="#D97A88"/>
                                            <TextBlock Text="Романтичний" FontSize="13" FontWeight="SemiBold" Foreground="#3D292D"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="0" Classes="ChoiceCard" Height="76"
                                            Command="{Binding ChooseMinimalismCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="70" Height="14" CornerRadius="4" Background="#F4B8C1"/>
                                            <TextBlock Text="Мінімалізм" FontSize="13" FontWeight="SemiBold" Foreground="#3D292D"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="2" Classes="ChoiceCard" Height="76"
                                            Command="{Binding ChooseStrictCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="70" Height="14" CornerRadius="4" Background="#8E8588"/>
                                            <TextBlock Text="Строгий" FontSize="13" FontWeight="SemiBold" Foreground="#3D292D"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Background="#FBF2F4" BorderBrush="#F0D5DA" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedStyle, StringFormat='Обраний стиль: {0}'}"
                                               FontSize="13" Foreground="#D97A88" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ================= КРОК 3 ================= -->
                        <StackPanel IsVisible="{Binding IsStep3}" Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Крок 3 з 3" FontSize="12" Foreground="#A88B92" FontWeight="Medium"/>
                                <TextBlock Text="Побажання" FontSize="22" FontWeight="Bold" Foreground="#3D292D"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Що потрібно включити" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <CheckBox IsChecked="{Binding IncludeVenue}" Content="Локація"/>
                                <CheckBox IsChecked="{Binding IncludeMusic}" Content="Музика"/>
                                <CheckBox IsChecked="{Binding IncludePhoto}" Content="Фотограф"/>
                                <CheckBox IsChecked="{Binding IncludeFood}" Content="Їжа / Кейтеринг"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Додаткові побажання" FontSize="13" FontWeight="SemiBold" Foreground="#594045"/>
                                <TextBox Text="{Binding Wishes}"
                                         Watermark="Наприклад: живий вокал, вегетаріанське меню..."
                                         Height="80"
                                         CornerRadius="8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         BorderBrush="#EADCE0"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>

                <!-- Нижня панель навігації -->
                <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="Скасувати"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsFirstStep}"
                                Background="Transparent" Foreground="#A88B92" FontWeight="Medium" Cursor="Hand"/>

                        <Button Grid.Column="0" Content="Назад"
                                Command="{Binding PreviousStepCommand}"
                                IsVisible="{Binding !IsFirstStep}"
                                Background="Transparent" Foreground="#594045" FontWeight="Medium" Cursor="Hand"/>

                        <Button Grid.Column="2" Content="Далі"
                                Command="{Binding NextStepCommand}"
                                IsVisible="{Binding !IsLastStep}"
                                Width="110" Height="40" CornerRadius="8"
                                Background="#D97A88" Foreground="White" FontWeight="SemiBold"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"/>

                        <Button Grid.Column="2" Content="Згенерувати план"
                                Command="{Binding SaveCommand}"
                                IsVisible="{Binding IsLastStep}"
                                Width="170" Height="40" CornerRadius="8"
                                Background="#D97A88" Foreground="White" FontWeight="SemiBold"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>
    </Border>
</Window>