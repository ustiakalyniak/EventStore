<Window x:Class="EventStore.WPF.CreateEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Створити подію"
        Height="500"
        Width="460"
        MinHeight="500"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F8FC"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Створити подію"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#20243A"/>
            <TextBlock Text="Заповни дані про свою майбутню подію"
                       FontSize="13"
                       Foreground="#73788C"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Назва події"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="NameTextBox"
                     Height="36"
                     Padding="9,7"
                     FontSize="14"
                     BorderBrush="#D9DDEA"
                     Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Дата події"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <DatePicker x:Name="DatePickerControl"
                        Height="36"
                        FontSize="14"
                        SelectedDate="{x:Null}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Кількість гостей"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="GuestsCountTextBox"
                     Height="36"
                     Padding="9,7"
                     FontSize="14"
                     BorderBrush="#D9DDEA"
                     Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Бюджет (грн)"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="BudgetTextBox"
                     Height="36"
                     Padding="9,7"
                     FontSize="14"
                     BorderBrush="#D9DDEA"
                     Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Скасувати"
                    Width="112"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Background="White"
                    BorderBrush="#D9DDEA"
                    Foreground="#42475B"/>
            <Button Content="Створити"
                    Width="112"
                    Height="38"
                    IsDefault="True"
                    Click="CreateButton_Click"
                    Background="#5B61D6"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>