<Window x:Class="EventStore.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventStore"
        Height="550"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FC"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок програми -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="EventStore"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#5B61D6"/>
            <TextBlock Text="Your smart event planner"
                       FontSize="13"
                       Foreground="#73788C"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Панель кнопок керування -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Створити подію"
                    Click="CreateEvent_Click"
                    Width="160"
                    Height="38"
                    Background="#5B61D6"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="0,0,12,0"/>

            <Button Content="Редагувати обрану"
                    Click="EditEvent_Click"
                    Width="160"
                    Height="38"
                    Background="#4E5180"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Таблиця для перегляду подій -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E3E6F0"
                BorderThickness="1">
            <DataGrid x:Name="EventsDataGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderBrush="#E3E6F0"/>
        </Border>
    </Grid>
</Window>